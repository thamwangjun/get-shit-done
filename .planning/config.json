{
  "model_profile": "quality",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": false,
    "ui_safety_gate": false,
    "ai_integration_phase": false,
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "use_worktrees": true,
    "code_review": true,
    "code_review_depth": "standard",
    "_auto_chain_active": false
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "model_overrides": {
    "gsd-doc-classifier": "sonnet",
    "gsd-doc-verifier": "sonnet",
    "gsd-doc-writer": "sonnet",
    "gsd-research-synthesizer": "sonnet",
    "gsd-pattern-mapper": "sonnet",
    "gsd-advisor-researcher": "sonnet",
    "gsd-assumptions-analyzer": "sonnet",
    "gsd-intel-updater": "sonnet",
    "gsd-codebase-mapper": "sonnet",
    "gsd-plan-checker": "sonnet",
    "gsd-integration-checker": "sonnet",
    "gsd-code-reviewer": "sonnet",
    "gsd-ui-checker": "sonnet",
    "gsd-ui-auditor": "sonnet",
    "gsd-domain-researcher": "sonnet",
    "gsd-user-profiler": "sonnet"
  },
  "resolve_model_ids": "omit",
  "mode": "yolo",
  "granularity": "coarse",
  "intel": {
    "enabled": true
  }
}
